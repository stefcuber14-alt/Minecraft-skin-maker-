{
  "name": "minecraft-skin-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Skin Studio — редактор скинов Minecraft (Android APK через Capacitor)",
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});['index.html','style.css','app.js'].forEach(f=>fs.copyFileSync(f,'www/'+f));\"",
    "android:sync": "npm run prepare-web && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
